      "html": "<div class=\"ds-scenario\"><output class=\"ds-scenario-value\">263 <span>rooftops</span></output><input class=\"ds-range\" type=\"range\" min=\"0\" max=\"1000\" value=\"263\" style=\"--fill:26.3%\"></div>",
